% ==========================================
% portfolio.sty - LaTeX Portfolio 共通設定
% ==========================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{portfolio}[2026/11/05 v1.0 LaTeX Portfolio common settings]

% ---------- 数式 ----------
\RequirePackage{amsmath,amssymb}

% ---------- 図表 ----------
\RequirePackage{graphicx}
\RequirePackage{booktabs}
\RequirePackage{pgfplots}
\RequirePackage{pgfplotstable}
\pgfplotsset{compat=1.18}
\usetikzlibrary{arrows.meta,decorations.pathreplacing}

% ---------- 索引 ----------
\RequirePackage{makeidx}
\makeindex

% ---------- 参考文献 ----------
\RequirePackage[backend=biber,style=ieee]{biblatex}
\addbibresource{src/references.bib}

% ---------- ハイパーリンク・PDF メタデータ ----------
% hyperref は他のパッケージの設定を書き換えるため、原則として最後の方で読み込む
\RequirePackage[pdfusetitle]{hyperref}   % \title と \author を PDF のプロパティに設定
\hypersetup{
  pdflang          = ja,
  bookmarksnumbered = true,
  colorlinks       = true,
  linkcolor        = blue!60!black,
  citecolor        = green!40!black,
  urlcolor         = blue!60!black,
}

% ---------- 相互参照（cleveref は hyperref より後に読み込む） ----------
\RequirePackage[nameinlink]{cleveref}
\crefformat{section}{#2第#1節#3}
\crefformat{subsection}{#2第#1節#3}
\crefformat{figure}{#2図#1#3}
\crefformat{table}{#2表#1#3}
\crefformat{equation}{#2式(#1)#3} % chktex 36
\Crefformat{section}{#2第#1節#3}
\Crefformat{subsection}{#2第#1節#3}
