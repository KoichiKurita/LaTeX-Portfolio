{
  "name": "LaTeX Portfolio",
  "build": { "dockerfile": "Dockerfile" },
  // 最小権限：root ではなく一般ユーザーで作業する
  "remoteUser": "texlive",
  // ホスト（WSL）のユーザーと UID/GID を合わせ、ファイル所有者のずれを防ぐ
  "updateRemoteUserUID": true,
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/node:2": { "version": "lts" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "james-yu.latex-workshop",
        "editorconfig.editorconfig",
        "github.vscode-pull-request-github",
        "github.vscode-github-actions",
        "redhat.vscode-yaml",
        "3w36zj6.textlint"
      ],
      "settings": {
        "files.encoding": "utf8",
        "files.eol": "\n",
        // ビルドは Makefile に一本化（人・エディタ・CIで同じ入口を使う）
        "latex-workshop.latex.tools": [
          { "name": "make", "command": "make", "args": ["-C", "%WORKSPACE_FOLDER%", "build"] }
        ],
        "latex-workshop.latex.recipes": [
          { "name": "make build", "tools": ["make"] }
        ],
        "latex-workshop.latex.outDir": "%WORKSPACE_FOLDER%/output",
        "latex-workshop.latex.autoBuild.run": "onSave",
        "latex-workshop.latex.autoClean.run": "never",
        "latex-workshop.view.pdf.viewer": "tab"
      }
    }
  },
  "postCreateCommand": "lualatex --version | head -1 && latexmk -v | head -2"
}
